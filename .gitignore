# Build outputs
*.exe
*.dll
*.so
*.dylib

# Test cache
*.test
*.out

# Go workspace
go.work
go.work.sum

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Design and scratch docs (committed separately if needed)
*.md.bak

# Superpowers SDD workspace (implementation artifacts, not source)
.superpowers/

# Local environment — contains secrets, never commit
.env

# SQLite scratch databases from local runs and tests. The -wal/-shm
# sidecars are easy to sweep up with `git add -A` and have been once.
*.db
*.db-wal
*.db-shm

# Claude Code runtime state that lands in the repo when a container runs an
# agent with this tree bind-mounted. .claude/agents, .claude/commands and
# .claude/settings.json ARE tracked on purpose — these two are not.
.claude/projects/
.claude/backups/
