# Copy this file to .env and fill in the values before running docker compose up.

# ── Claude Code authentication (pick ONE) ─────────────────────────────────────
#
# Option A — Claude.ai subscription (recommended for personal use):
#   Point CLAUDE_HOME at your local ~/.claude directory. The shem container
#   reuses your existing login session — no API key or extra auth step needed.
#
#   Windows:  CLAUDE_HOME=C:/Users/YourName/.claude  (forward slashes required)
#   Mac/Linux: CLAUDE_HOME=/Users/yourname/.claude   (or $HOME/.claude)
#
#   Uncomment and set it to YOUR path. Left commented, the shem uses a
#   throwaway volume instead and you authenticate with Option B or C — this
#   line used to ship uncommented with the placeholder still in it, so a
#   straight copy of this file made Docker try to mount a directory that
#   exists on nobody's machine.
#
# CLAUDE_HOME=
#
# Option B — Claude subscription, headless (no CLAUDE_HOME mount needed):
#   Generate a long-lived OAuth token with `claude setup-token` (requires an
#   active Pro/Max subscription), then set it here. Useful for CI, remote
#   shems, or containers without access to your host ~/.claude directory.
#
# CLAUDE_CODE_OAUTH_TOKEN=
#
# Option C — Anthropic API key:
#   Uncomment and set if you prefer to use an API key instead of a subscription.
#   Get one at https://console.anthropic.com/
#
# ANTHROPIC_API_KEY=sk-ant-...

# ── Admin dashboard credentials ───────────────────────────────────────────────
# Change these in production.
GOLEM_ADMIN_USERNAME=admin
GOLEM_ADMIN_PASSWORD=changeme

# ── Shem API key ──────────────────────────────────────────────────────────────
# Shared secret between orchestrator and shem. Generate with:
#   openssl rand -hex 32   (Mac/Linux)
#   [System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32) | ForEach-Object { '{0:x2}' -f $_ } | Join-String  (PowerShell)
# Or just paste any long random string — it's hashed before storage.
GOLEM_SHEM_API_KEY=changeme-replace-with-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────
# Name shown for this shem in the dashboard (default: "default").
# GOLEM_SHEM_NAME=my-shem

# Absolute path to a real project repo to mount into the shem for real tickets.
# Defaults to the current directory. The test repo (local://test) is always
# available for experimentation without touching your actual codebase.
# GOLEM_REPO_PATH=/path/to/your/project

# ── GitHub Issues integration (optional) ──────────────────────────────────────
# Fine-grained PAT for the ORCHESTRATOR, and only the orchestrator. It reads
# this for the issue polling and the write outbox: labels, milestone comments,
# closing an issue, and opening the pull request.
#
# Required repository permissions:
#   Issues:        Read and write
#   Pull requests: Read and write
#   Contents:      Read            (read-only is enough here; the branch push
#                                   happens on the shem, see below)
#   Metadata:      Read
# Leave empty to run without GitHub sync.
GOLEM_GITHUB_TOKEN=

# ── Shem push credential (optional, and separate on purpose) ──────────────────
# The branch a pull request is opened from is pushed on the SHEM host, not by
# the orchestrator, so the shem needs its own credential. Set this and the
# container's entrypoint installs it as an HTTPS git credential helper scoped
# to github.com. A host that already has SSH keys or a credential manager can
# rely on those instead and leave this empty.
#
# It is a separate variable rather than a reuse of GOLEM_GITHUB_TOKEN because
# the shem container is where the agent runs, on issue text anyone can write.
# Leaving this empty — the default — means a successful prompt injection there
# gets no repository credential at all. Prefer a second, push-only token over
# pasting the same PAT.
#
# You need it only when deploy/shem.yaml's `no_push: true` is turned off; until
# then no push and no pull request happen at all. See the comment in that file.
# GOLEM_SHEM_GITHUB_TOKEN=
